# Anthropic API key (used by BE-2's concierge; not required for BE-1's pipeline)
ANTHROPIC_API_KEY=

# HMAC secret for anonymizing RUT → anon_id. MUST be set. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=

# SQLite database file
DATABASE_URL=sqlite:///./defensor.db

# MCP server (BE-2's RAG service). BE-1 does not call it.
MCP_SERVER_URL=http://localhost:8001

# Optional: Voyage embeddings for BE-2's RAG indexer
VOYAGE_API_KEY=
